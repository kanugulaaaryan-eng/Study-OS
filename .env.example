# StudyOS - Environment Variables
# Fill in your actual values below

# Database (TiDB Serverless - free, MySQL-compatible, no credit card)
# Get from TiDB Cloud Console: https://tidbcloud.com
# Format: mysql://user:password@gateway01.region.tidbcloud.com:4000/studyos?ssl={"rejectUnauthorized":false}
DATABASE_URL=mysql://user:password@host:4000/studyos?ssl={"rejectUnauthorized":false}

# NVIDIA NIM API (free tier available, OpenAI-compatible)
# Get API key from: https://build.nvidia.com/explore/discover
# Model: openai/gpt-oss-120b (free, reasoning model)
NVIDIA_NIM_API_KEY=your_nvidia_nim_api_key_here
# Alias also accepted: NIM_API_KEY=your_nvidia_nim_api_key_here
NVIDIA_NIM_API_URL=https://integrate.api.nvidia.com/v1
# Alias also accepted: NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=openai/gpt-oss-120b
NVIDIA_NIM_REASONING_MODEL=openai/gpt-oss-120b

# LLM Provider (nvidia-nim or forge)
LLM_PROVIDER=nvidia-nim  # also accepts: nim

# Authentication (JWT for email/password auth)
JWT_SECRET=your_32_char_min_jwt_secret_here
# Owner OpenID for admin access (optional)
OWNER_OPEN_ID=your_owner_open_id_here

# Google OAuth (for social login)
# Create at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# App Config
VITE_APP_ID=your_app_id
VITE_APP_TITLE="StudyOS — AI Learning Platform"
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=
VITE_OAUTH_PORTAL_URL=

# Forge API (only needed if LLM_PROVIDER=forge)
BUILT_IN_FORGE_API_KEY=
BUILT_IN_FORGE_API_URL=https://forge.manus.ai
VITE_FRONTEND_FORGE_API_KEY=
VITE_FRONTEND_FORGE_API_URL=https://forge.manus.ai

# Server
PORT=3000
NODE_ENV=development

# SSL config for TiDB (optional, defaults to rejectUnauthorized: false)
SSL_REJECT_UNAUTHORIZED=false